def find_stop(prim, label, point=None):
    """Stop point on the rail: over the prim's footprint, as close to its
    centre (or to point) as the rail allows. One entry per driving direction."""
    if prim is None or not prim.IsValid() or not prim.IsActive():
        print(label, "NOT FOUND")
        return None
    if UsdGeom.Imageable(prim).ComputeVisibility(TIME) == UsdGeom.Tokens.invisible:
        print(label, "IS HIDDEN - skipping")
        return None
    lo, hi = world_bounds(prim)
    lo_h, hi_h = lo[H_IDX], hi[H_IDX]
    centre_h = 0.5 * (lo_h + hi_h)
    if point is not None:
        centre_h = np.array(point[:2], dtype=float)
        lo_h = hi_h = centre_h

    rows = []
    for i, e in enumerate(E):
        ph = e["pts"][:, H_IDX]
        outside = np.maximum(np.maximum(lo_h - ph, ph - hi_h), 0.0)
        d_foot = np.linalg.norm(outside, axis=1)    # 0 = rail is over it
        d_cent = np.linalg.norm(ph - centre_h, axis=1)
        key = d_foot * 1000.0 + d_cent
        j = int(np.argmin(key))
        rows.append((float(key[j]), float(d_foot[j]), float(d_cent[j]),
                     i, float(e["cum"][j])))
    best = min(rows)
    _, foot, cent = best[:3]
    if foot > rail_offset_u:
        print(f"{label}: nearest rail is {foot * MPU:.2f} m outside it "
              f"(limit {MAX_RAIL_OFFSET} m)")
        return None
    where = "over it" if foot == 0 else f"{foot * MPU:.2f} m beside it"
    print(f"{label}: stop point is {where}, {cent * MPU:.2f} m from its centre")
    return {i: s for k, f, c, i, s in rows if k <= best[0] + 1e-3 * U}


def plan_route(cur, s, targets):
    """Shortest drive from (cur, s) to any target. Returns (edges after cur, stop_s)."""
    if cur in targets and targets[cur] >= s:
        return [], targets[cur]
    dist, prev, heap = {}, {}, []
    rem = E[cur]["L"] - s
    for n in successors(cur):
        dist[n], prev[n] = rem, None
        heapq.heappush(heap, (rem, n))
    while heap:
        d, e = heapq.heappop(heap)
        if d > dist.get(e, float("inf")):
            continue
        if e in targets:
            chain, x = [], e
            while x is not None:
                chain.append(x)
                x = prev[x]
            return chain[::-1], targets[e]
        for n in successors(e):
            nd = d + E[e]["L"]
            if nd < dist.get(n, float("inf")):
                dist[n], prev[n] = nd, e
                heapq.heappush(heap, (nd, n))
    return None, None

# ============================================================
# CARRYING THE LOAD
# ============================================================
carry = {"on": False, "Pinv": None, "H0inv": None, "L0": None}


def load_world_op(world_transform):
    """Set the prepended load op so the complete prim has this world transform."""
    parent_inv = parent_world(load).GetInverse()
    carry_op.Set(world_transform * parent_inv * load_base_local_inv)


def attach_load():
    if not (carry_op and hoist):
        return
    carry.update(on=True,
                 Pinv=parent_world(load).GetInverse(),
                 H0inv=world_matrix(hoist).GetInverse(),
                 L0=world_matrix(load))


def detach_load():
    carry["on"] = False                  # the magazine stays where it is


def carry_update():
    """Keep the load rigidly fixed to the hoist without changing its local transform."""
    if carry["on"]:
        desired_world = carry["L0"] * carry["H0inv"] * world_matrix(hoist)
        carry_op.Set(desired_world * carry["Pinv"] * load_base_local_inv)

# ============================================================
# CANCEL OLD TASK
# ============================================================
if "oht_follow_task" in globals():
    old_task = oht_follow_task
    if old_task is not None and not old_task.done():
        old_task.cancel()

# ============================================================
# DRIVING
# ============================================================
st = {"prev": None, "cur": start_edge, "s": start_s, "nxt": None,
      "dir": entry_dir(E[start_edge])}


def place():
    a = (st["prev"], st["cur"], st["nxt"])
    pos = route_point(*a, st["s"])
    d = route_point(*a, st["s"] + half_span_u) - route_point(*a, st["s"] - half_span_u)
    if np.linalg.norm(d) > 1e-9:
        st["dir"] = d
    apply_pose(pos, st["dir"])
    update_hoist()
    carry_update()


async def drive(plan=None, stop_s=None):
    """plan=None: follow the rails freely until a dead end.
    plan=[edges]: follow exactly those edges, stop at stop_s on the last one."""
    plan = list(plan) if plan is not None else None

    def pick_next():
        if plan is not None:
            return plan.pop(0) if plan else None
        return choose_next(st["cur"])

    def at_stop():
        return (plan is not None and stop_s is not None
                and st["nxt"] is None and st["s"] >= stop_s)

    st["nxt"] = pick_next()
    last = time.perf_counter()
    while True:
        now = time.perf_counter()
        dt = min(now - last, 0.1)
        last = now
        st["s"] += speed_u * dt

        arrived = at_stop()
        dead_end = False
        while not arrived and st["s"] >= E[st["cur"]]["L"]:
            if st["nxt"] is None:
                st["s"] = E[st["cur"]]["L"]
                dead_end = True
                break
            st["s"] -= E[st["cur"]]["L"]
            st["prev"], st["cur"] = st["cur"], st["nxt"]
            st["nxt"] = pick_next()
            arrived = at_stop()
        if arrived:
            st["s"] = stop_s

        place()
        if arrived:
            return "arrived"
        if dead_end:
            return "dead_end"
        await app.next_update_async()


async def animate(duration, fn):
    t0 = time.perf_counter()
    while True:
        a = 1.0 if duration <= 0 else min((time.perf_counter() - t0) / duration, 1.0)
        fn(ease(a))
        update_hoist()
        carry_update()
        if a >= 1.0:
            return
        await app.next_update_async()


async def wait(seconds):
    await animate(seconds, lambda a: None)

# ============================================================
# HOIST / GRIPPER SEQUENCES
# ============================================================
async def move_hoist(level):
    start = hoist_drop[0]
    dist = abs(level - start)
    t = dist / hoist_speed_u if hoist_speed_u > 0 else 0.0
    await animate(t, lambda a: set_drop(start + (level - start) * a))


async def hoist_cycle(drop, at_bottom, end_level=0.0):
    """Lower by drop from where the hoist is now, run at_bottom(),
    then lift to end_level (0 = rest, negative = higher than rest)."""
    bottom = hoist_drop[0] + max(drop, 0.0)
    print(f"LOWER HOIST {max(drop, 0.0) * MPU:.3f} m")
    await move_hoist(bottom)
    await wait(PAUSE_TIME)
    await at_bottom()
    await wait(PAUSE_TIME)
    print("LIFT HOIST")
    await move_hoist(end_level(bottom) if callable(end_level) else end_level)


async def close_gripper():
    print("CLOSE GRIPPER")

    def step(a):
        set_claws(a)
        for op, off in fingers:
            op.Set(off * a)
    await animate(GRIP_TIME, step)
    attach_load()


async def open_gripper():
    print("OPEN GRIPPER")
    detach_load()

    def step(a):
        set_claws(1.0 - a)
        for op, off in fingers:
            op.Set(off * (1.0 - a))
    await animate(GRIP_TIME, step)


def hoist_bounds():
    b = [world_bounds(p) for p in hoist_parts]
    return np.min([x[0] for x in b], axis=0), np.max([x[1] for x in b], axis=0)


hoist_align_op = front_op(hoist, "hoistAlign", "translate") if hoist is not None else None
if hoist_align_op is not None:
    hoist_align_op.Set(Gf.Vec3d(0.0, 0.0, 0.0))


def align_hoist_over(prim):
    """Shift the hoist horizontally so its center is above the target prim."""
    if hoist is None or hoist_align_op is None:
        raise RuntimeError("Cannot align the magazine: no valid hoist is available.")
    target_lo, target_hi = world_bounds(prim)
    target = 0.5 * (target_lo + target_hi)
    hoist_lo, hoist_hi = hoist_bounds()
    centre = 0.5 * (hoist_lo + hoist_hi)
    offset = target - centre
    offset[UP_I] = 0.0
    local_offset = parent_world(hoist).GetInverse().TransformDir(
        Gf.Vec3d(*map(float, offset)))
    hoist_align_op.Set(local_offset)
    print(f"HOIST HORIZONTAL ALIGN: {np.linalg.norm(offset) * MPU:.3f} m")


async def pick_magazine():
    # body size measured now, with the hoist at rest inside it
    b_lo, b_hi = world_bounds(oht)
    h_lo, h_hi = hoist_bounds()
    _, m_hi = world_bounds(load)

    def stow_level(bottom):
        """Hoist level that pulls the magazine up inside the body."""
        if not STOW_INSIDE:
            return 0.0
        m_lo, _ = world_bounds(load)               # measured at the bottom
        # raise until magazine bottom is just above the body bottom ...
        level = bottom - (b_lo[UP_I] + STOW_MARGIN * U - m_lo[UP_I])
        # ... but never push the gripper out through the top of the body
        top_limit = h_hi[UP_I] - b_hi[UP_I]
        if level < top_limit:
            print("Magazine is taller than the space in the OHT body - "
                  "it will stick out underneath")
            level = top_limit
        return min(level, 0.0)

    contact_lo = (world_bounds(hoist_unit["plate"])[0] if hoist_unit["plate"] is not None
                  else h_lo)
    await hoist_cycle(contact_lo[UP_I] - m_hi[UP_I] - clearance_u, close_gripper, stow_level)
    print("MAGAZINE PICKED UP" + (" AND STOWED INSIDE THE OHT" if STOW_INSIDE else ""))


def mesh_triangles(root_prim, skip=()):
    """All triangles (world space, shape (n, 3, 3)) of meshes under root_prim."""
    tris = []
    for p in Usd.PrimRange(root_prim, Usd.TraverseInstanceProxies()):
        path = str(p.GetPath())
        if any(path.startswith(x) for x in skip) or not p.IsA(UsdGeom.Mesh):
            continue
        if UsdGeom.Imageable(p).ComputeVisibility(TIME) == UsdGeom.Tokens.invisible:
            continue
        mesh = UsdGeom.Mesh(p)
        pts = mesh.GetPointsAttr().Get(TIME)
        fvc = mesh.GetFaceVertexCountsAttr().Get(TIME)
        fvi = mesh.GetFaceVertexIndicesAttr().Get(TIME)
        if not pts or not fvc or not fvi:
            continue
        P = np.array(pts, dtype=float)
        M = np.array(world_matrix(p))
        P = (np.c_[P, np.ones(len(P))] @ M)[:, :3]
        counts = np.array(fvc, dtype=int)
        idx = np.array(fvi, dtype=int)
        offs = np.concatenate([[0], np.cumsum(counts)[:-1]])
        n = counts - 2
        ok = n > 0
        if not ok.any():
            continue
        face = np.repeat(np.arange(len(counts))[ok], n[ok])
        k = (np.arange(n[ok].sum())
             - np.repeat(np.cumsum(n[ok]) - n[ok], n[ok]) + 1)
        base = offs[face]
        tris.append(P[np.stack([idx[base], idx[base + k], idx[base + k + 1]], axis=1)])
    return np.concatenate(tris) if tris else np.zeros((0, 3, 3))


def surface_below(tris, xy, start_h):
    """Height of the highest triangle under horizontal point xy, below start_h."""
    if len(tris) == 0:
        return None
    a, b, c = (tris[:, i, :] for i in range(3))
    A, B, C = a[:, H_IDX], b[:, H_IDX], c[:, H_IDX]
    v0, v1, v2 = B - A, C - A, xy - A
    den = v0[:, 0] * v1[:, 1] - v1[:, 0] * v0[:, 1]
    good = np.abs(den) > 1e-12
    den = np.where(good, den, 1.0)
    u = (v2[:, 0] * v1[:, 1] - v1[:, 0] * v2[:, 1]) / den
    v = (v0[:, 0] * v2[:, 1] - v2[:, 0] * v0[:, 1]) / den
    inside = good & (u >= -1e-6) & (v >= -1e-6) & (u + v <= 1 + 1e-6)
    h = a[:, UP_I] + u * (b[:, UP_I] - a[:, UP_I]) + v * (c[:, UP_I] - a[:, UP_I])
    h = h[inside & (h <= start_h + 1e-4 * U)]
    return float(h.max()) if len(h) else None


def landing_height():
    """Highest surface directly under the magazine's footprint."""
    m_lo, m_hi = world_bounds(load)
    lo_h, hi_h = m_lo[H_IDX], m_hi[H_IDX]
    mid, half = 0.5 * (lo_h + hi_h), 0.4 * (hi_h - lo_h)
    samples = [mid] + [mid + half * np.array(sg) for sg in
                       ((1, 1), (1, -1), (-1, 1), (-1, -1))]
    skip = (str(oht.GetPath()), str(load.GetPath()), DEBUG_ROOT, TRACK_ROOT)

    roots = [PLACE_SURFACE_PATH or PLACE_MACHINE_PATH, "/"]
    for r in roots:
        prim = stage.GetPrimAtPath(r) if r != "/" else stage.GetPseudoRoot()
        if not prim.IsValid():
            continue
        if r == "/":
            print("Nothing of machine 2 under the magazine - checking the whole scene")
        tris = mesh_triangles(prim, skip)
        hits = [surface_below(tris, xy, m_lo[UP_I]) for xy in samples]
        hits = [h for h in hits if h is not None]
        if hits:
            return max(hits)
    return None


async def place_on_target():
    target = np.array(world_matrix(place_target).ExtractTranslation(), dtype=float)
    m_lo, _ = world_bounds(load)
    drop = m_lo[UP_I] - target[UP_I]
    print(f"Setting the magazine down on the drop target, lowering {drop * MPU:.3f} m")

    async def at_bottom():
        detach_load()
        lo, hi = world_bounds(load)
        now = 0.5 * (lo + hi)
        now[UP_I] = lo[UP_I]
        v = target - now                      # small final correction
        start_world = world_matrix(load)
        await animate(0.4, lambda a: load_world_op(
            start_world * translate_m(v * a)))
        await open_gripper()

    await hoist_cycle(drop, at_bottom)
    print("MAGAZINE PLACED")


async def place_magazine():
    if PLACE_MODE == "target" and place_target is not None:
        await place_on_target()
        return
    m_lo, _ = world_bounds(load)
    top = landing_height()
    if top is None:
        print("NO SURFACE FOUND under the magazine - not lowering. "
              "Check PLACE_POINT / machine 2 position.")
        return
    drop = m_lo[UP_I] - top
    print(f"Surface under magazine at height {top * MPU:.3f} m, "
          f"lowering {drop * MPU:.3f} m")
    await hoist_cycle(drop, open_gripper)
    print("MAGAZINE PLACED")


async def go_to(targets, label):
    """Drive to the stop point; returns True when the OHT is there."""
    route, stop_s = plan_route(st["cur"], st["s"], targets)
    tw = E[st["cur"]]["twin"]
    if route is None and tw is not None:          # try the other direction
        route, stop_s = plan_route(tw, E[tw]["L"] - st["s"], targets)
        if route is not None:
            st["s"] = E[tw]["L"] - st["s"]
            st["cur"], st["prev"] = tw, None
    if route is None:
        print(label, "CANNOT BE REACHED on the rails from here")
        return False
    print(f"DRIVING TO {label} ({len(route)} edges)")
    if await drive(route, stop_s) != "arrived":
        print("DEAD END before", label)
        return False
    print("STOPPED ABOVE", label)
    await wait(PAUSE_TIME)
    return True

# ============================================================
# MAIN SEQUENCE
# ============================================================
async def run():
    print("OHT STARTED")
    place()
    init_hoist()
    update_hoist()
    try:
        if hoist is None or load is None:
            print("Need both a hoist and a magazine - see messages above.")
            return
        pick = find_stop(load, "MAGAZINE ON MACHINE 1")
        if PLACE_MODE == "target" and place_target is not None:
            tp = np.array(world_matrix(place_target).ExtractTranslation(), dtype=float)
            drop = find_stop(stage.GetPrimAtPath(PLACE_MACHINE_PATH), "DROP TARGET",
                             tp[H_IDX])
        else:
            pt = None if PLACE_POINT is None else np.array(PLACE_POINT[:2]) * U
            drop = find_stop(stage.GetPrimAtPath(PLACE_MACHINE_PATH), "MACHINE 2", pt)
        if not pick:
            print("Cannot reach the magazine - nothing to do.")
            return

        if not await go_to(pick, "MACHINE 1"):
            return
        align_hoist_over(load)
        await pick_magazine()

        if not drop:
            print("HOLDING THE MAGAZINE - the drop spot is not under a rail. "
                  "Move the drop target under a rail or raise MAX_RAIL_OFFSET.")
            return
        if not await go_to(drop, "MACHINE 2"):
            return
        await place_magazine()
        print("TRANSFER COMPLETE")

        if CONTINUE_AFTER_PLACE:
            await drive()
            print("OHT REACHED A DEAD END - stopped")

    except asyncio.CancelledError:
        print("OHT MOVEMENT STOPPED")
        raise
    except Exception as error:
        print("OHT MOVEMENT ERROR:", error)
        raise


oht_follow_task = asyncio.ensure_future(run())
