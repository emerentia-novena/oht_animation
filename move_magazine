def front_op(prim, suffix, kind):
    """Get or create an op placed FIRST in the op order, so it moves the prim
    in its parent's space without touching the prim's own transform."""
    xf = UsdGeom.Xformable(prim)
    name = f"xformOp:{kind}:{suffix}"
    ops = list(xf.GetOrderedXformOps())
    for op in ops:
        if op.GetOpName() == name:
            return op
    if kind == "translate":
        op = xf.AddTranslateOp(UsdGeom.XformOp.PrecisionDouble, suffix)
        op.Set(Gf.Vec3d(0.0, 0.0, 0.0))
    else:
        op = xf.AddTransformOp(UsdGeom.XformOp.PrecisionDouble, suffix)
        op.Set(Gf.Matrix4d(1.0))
    xf.SetXformOpOrder([op] + ops)
    return op


def world_matrix(prim):
    return UsdGeom.Xformable(prim).ComputeLocalToWorldTransform(TIME)


def parent_world(prim):
    par = prim.GetParent()
    if par.IsValid() and par.GetPath() != stage.GetPseudoRoot().GetPath():
        return world_matrix(par)
    return Gf.Matrix4d(1.0)


def world_bounds(prim):
    cache = UsdGeom.BBoxCache(TIME, [UsdGeom.Tokens.default_, UsdGeom.Tokens.render])
    r = cache.ComputeWorldBound(prim).ComputeAlignedRange()
    return np.array(r.GetMin(), dtype=float), np.array(r.GetMax(), dtype=float)


def _too_big(p):
    """True if p is (nearly) the whole OHT rather than a gripper part."""
    if p == oht or str(oht.GetPath()).startswith(str(p.GetPath()) + "/"):
        return True
    try:
        o_lo, o_hi = world_bounds(oht)
        h_lo, h_hi = world_bounds(p)
    except Exception:
        return False
    o = np.maximum(o_hi - o_lo, 1e-9)
    h = np.maximum(h_hi - h_lo, 0.0)
    return float(np.prod(h) / np.prod(o)) > 0.5


def list_oht_parts(max_depth=4, limit=60):
    """Print the OHT's parts with size and how low they hang."""
    o_lo, _ = world_bounds(oht)
    root_depth = str(oht.GetPath()).count("/")
    rows = []
    for p in Usd.PrimRange(oht):
        depth = str(p.GetPath()).count("/") - root_depth
        if p == oht or depth > max_depth or not p.IsA(UsdGeom.Xformable):
            continue
        if "virtual_hoist" in str(p.GetPath()).lower():
            continue
        lo, hi = world_bounds(p)
        if not (np.all(np.isfinite(lo)) and np.all(hi >= lo)):
            continue
        rows.append((depth, str(p.GetPath()), (hi - lo) * MPU,
                     (lo[UP_I] - o_lo[UP_I]) * MPU))
    print("-" * 60)
    print("PARTS INSIDE THE OHT (size in m; bottom = height above the OHT's lowest point)")
    for depth, path, size, bot in rows[:limit]:
        print(f"  {'  ' * (depth - 1)}{path}   size {np.round(size, 2)}  bottom {bot:.2f}")
    if len(rows) > limit:
        print(f"  ... {len(rows) - limit} more")
    print("Put the gripper plate (and parts that go down with it) in HOIST_PATHS.")
    print("-" * 60)


