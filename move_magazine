def make_hoist_unit():
    """Hoist plate with a claw on the front and back, tucked inside the
    bottom of the OHT body. It is lowered on cables; the claws close on the
    magazine sides with their tips under its edge."""
    path = str(oht.GetPath()) + "/Hoist_Unit"
    stage.RemovePrim(path)
    stage.RemovePrim(str(oht.GetPath()) + "/Virtual_Hoist")

    # frame: forward = OHT long side, up = world up
    M = world_matrix(oht)
    horiz = [i for i in range(3) if i != up_i]
    size = {i: (o_hi - o_lo)[i] * scale_vec[i] for i in horiz}
    long_ax = max(horiz, key=size.get)
    fwd = np.array(M.TransformDir(Gf.Vec3d(*np.eye(3)[long_ax])), dtype=float)
    fwd = unit(fwd - np.dot(fwd, UP_VEC) * UP_VEC)
    lat = unit(np.cross(UP_VEC, fwd))
    if Z_UP:
        rows = [fwd, lat, UP_VEC]
        L = lambda f, l, u: Gf.Vec3d(float(f), float(l), float(u))
    else:
        rows = [fwd, UP_VEC, unit(np.cross(fwd, UP_VEC))]
        L = lambda f, l, u: Gf.Vec3d(float(f), float(u), float(l))

    # sizes from the magazine
    if load is not None:
        lo, hi = world_bounds(load)
        ext = hi - lo
        Lf = abs(fwd[H_IDX[0]]) * ext[H_IDX[0]] + abs(fwd[H_IDX[1]]) * ext[H_IDX[1]]
        Ll = abs(lat[H_IDX[0]]) * ext[H_IDX[0]] + abs(lat[H_IDX[1]]) * ext[H_IDX[1]]
        Hm = ext[UP_I]
    else:
        Lf = Ll = Hm = 0.3 * U
    plate_t, claw_t = 0.03 * U, 0.012 * U
    hook = CLAW_HOOK * U
    arm = float(np.clip(0.3 * Hm, 0.04 * U, 0.12 * U))
    PL, PW = max(0.9 * Lf, 0.1 * U), max(0.8 * Ll, 0.1 * U)
    claw_w = max(0.5 * Ll, 0.05 * U)
    closed = 0.5 * Lf + 0.5 * claw_t + 0.002 * U
    opened = closed + CLAW_OPEN * U

    # rest position: tucked up inside the bottom of the body
    b_lo, b_hi = world_bounds(oht)
    tuck = min(plate_t + arm, 0.45 * (b_hi - b_lo)[UP_I])
    origin = oht_bottom_world() + UP_VEC * tuck
    vals = [*rows[0], 0.0, *rows[1], 0.0, *rows[2], 0.0, *origin, 1.0]
    W = Gf.Matrix4d(*[float(v) for v in vals])

    xf = UsdGeom.Xform.Define(stage, path)
    xf.AddTransformOp(UsdGeom.XformOp.PrecisionDouble).Set(W * M.GetInverse())

    def box(p, centre, dims, colour):
        c = UsdGeom.Cube.Define(stage, p)
        c.CreateSizeAttr(1.0)
        c.AddTranslateOp().Set(centre)
        c.AddScaleOp().Set(Gf.Vec3f(*map(float, dims)))
        c.CreateDisplayColorAttr(Vt.Vec3fArray([Gf.Vec3f(*colour)]))
        return c

    plate = box(path + "/Plate", L(0, 0, -0.5 * plate_t), L(PL, PW, plate_t),
                (0.85, 0.85, 0.85))
    claws = []
    for name, sgn in (("Claw_Front", 1.0), ("Claw_Back", -1.0)):
        cx = UsdGeom.Xform.Define(stage, f"{path}/{name}")
        op = cx.AddTranslateOp()
        op.Set(L(sgn * opened, 0, 0))
        box(f"{path}/{name}/Arm", L(0, 0, -plate_t - 0.5 * arm),
            L(claw_t, claw_w, arm), (0.3, 0.3, 0.32))
        box(f"{path}/{name}/Tip", L(-sgn * 0.5 * hook, 0, -plate_t - arm + 0.5 * claw_t),
            L(hook + claw_t, claw_w, claw_t), (0.3, 0.3, 0.32))
        claws.append((op, sgn))

    hoist_unit.update(plate=plate.GetPrim(), claws=claws, open=opened, closed=closed,
                      L=L, cables=[L(f * 0.35 * PL, l * 0.35 * PW, 0.0)
                                   for f in (-1, 1) for l in (-1, 1)])
    print(f"HOIST UNIT built: plate {PL * MPU:.2f} x {PW * MPU:.2f} m, "
          f"claws on the front and back, arm {arm * MPU:.2f} m")
    return xf.GetPrim()


def set_claws(a):
    """a = 0 open, 1 closed."""
    hu = hoist_unit
    for op, sgn in hu["claws"]:
        op.Set(hu["L"](sgn * (hu["open"] + (hu["closed"] - hu["open"]) * a), 0, 0))


def translate_m(v):
    m = Gf.Matrix4d(1.0)
    m.SetTranslate(Gf.Vec3d(*map(float, v)))
    return m


def local_bounds(prim):
    cache = UsdGeom.BBoxCache(TIME, [UsdGeom.Tokens.default_, UsdGeom.Tokens.render])
    r = cache.ComputeUntransformedBound(prim).ComputeAlignedRange()
    return np.array(r.GetMin(), dtype=float), np.array(r.GetMax(), dtype=float)


def up_axis(to_world_dir):
    """Which local axis points up in the world, and with which sign."""
    axes = [np.array(to_world_dir(Gf.Vec3d(*np.eye(3)[i])), dtype=float) for i in range(3)]
    i = int(np.argmax([abs(np.dot(unit(a), UP_VEC)) for a in axes]))
    return i, (1.0 if np.dot(axes[i], UP_VEC) > 0 else -1.0), axes


def face_centre(lo, hi, ax, sign, top=True):
    c = 0.5 * (lo + hi)
    c[ax] = (hi if (sign > 0) == top else lo)[ax]
    return c


