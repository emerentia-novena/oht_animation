# ============================================================
# OHT RAIL FOLLOWER - MOVE A MAGAZINE FROM MACHINE 1 TO MACHINE 2
# ISAAC SIM 6.0  -  run from the Script Editor
# ============================================================
#
# "Drives straight, then stops before the curve" means the straight rail
# and the curve are NOT connected in the track data. Usually one of:
#   a) the curves live in a different prim than Track_Edges,
#   b) the curve starts a few cm/mm away from where the straight ends,
#   c) the curve was drawn in the opposite direction.
# This script builds the missing junction curves itself (cyan lines in the
# viewport) and drives the OHT along the rails until a real dead end.
# ============================================================

import asyncio
import heapq
import math
import time
from collections import defaultdict

import numpy as np
import omni.kit.app
import omni.usd
from pxr import Gf, Usd, UsdGeom, Vt

stage = omni.usd.get_context().get_stage()
app = omni.kit.app.get_app()

# Root of the tracking network: EVERY BasisCurves prim below it is used
TRACK_ROOT = "/World/OHT_Waypoint_Network"
OHT_HINT = "/World/OHT2grip_Revised"   # the OHT that drives and picks
HIDE_PRIMS = ["/World/OHT_ASE"]       # other OHT models to hide (eye icon brings them back)
DEBUG_ROOT = "/World/OHT_Debug"
SHOW_DEAD_END_MARKERS = False

SPEED = 0.5            # metres / second
AT_JUNCTION = "turn"   # "turn" = take the curve, "straight" = keep straight
SAMPLE_STEP = 0.02     # metres between sampled points on the rail
SNAP_TOL = 0.05        # metres: endpoints closer than this are one node
JUNCTION_RADIUS = 2.0  # metres: rail ends this close are joined through a junction
MAX_TURN_DEG = 100.0   # largest turn allowed through a junction (90 = corner)
BIDIRECTIONAL = True   # ignore the drawing direction of the curves
HEADING_SPAN = 0.15    # metres: tangent measured over this span
AUTO_ALIGN = True      # turn the OHT so its long side follows the rail
YAW_OFFSET_DEG = 0.0   # extra turn: 90 / 180 / -90 if it still faces wrong
HEIGHT_OFFSET = 0.1   # metres: + moves the OHT up, - down, from "top on rail"
TIME = Usd.TimeCode.Default()


# ------------------------------------------------------------
# Magazine transfer: pick at machine 1, place at machine 2
# ------------------------------------------------------------
PICK_MACHINE_PATH = "/World/Ground_Machine_1"   # machine the magazine sits on
PLACE_MACHINE_PATH = "/World/Ground_Machine_2"  # machine to put it on
MAGAZINE_PATH = "/World/full"     # e.g. "/World/Magazine_1"; "" = auto-find on machine 1
PLACE_MODE = "target"  # "target" = put it exactly on the green drop-target box
                       # "surface" = put it on whatever surface is under it
PLACE_TARGET_PATH = "/World/Magazine_Drop_Target"  # move this box inside machine 2
PLACE_SURFACE_PATH = ""  # surface mode only: load-port prim to set it down on
PLACE_POINT = None     # surface mode only: (x, y) world metres, e.g. (14.2, -3.1)
CONTINUE_AFTER_PLACE = False  # True = keep driving the rail afterwards
MAX_RAIL_OFFSET = 0.5  # metres: stop point must be this close to a rail
HOIST_PATH = ""        # the gripper plate that goes down; "" = auto-find
# If the gripper is made of several parts (plate, fingers, sensor...), list
# them all here; they are lowered together. Overrides HOIST_PATH.
HOIST_PATHS = [
    # "/World/OHT2grip_Revised/Gripper_Plate",
    # "/World/OHT2grip_Revised/Gripper_Finger_L",
]
LIST_OHT_PARTS = False  # print the parts inside the OHT to help pick the hoist
BUILD_HOIST = True     # build a hoist unit (plate + 2 claws) inside the OHT body.
                       # Used unless HOIST_PATH / HOIST_PATHS is set.
CLAW_OPEN = 0.03       # metres each claw opens beyond the magazine side
CLAW_HOOK = 0.015      # metres the claw tip reaches in under the magazine edge
VIRTUAL_HOIST = True   # fallback: plain gripper pad if nothing else is available
PAD_SIZE = (0.35, 0.35, 0.04)  # metres: size of that gripper pad
HOIST_SPEED = 0.3      # metres / second, up and down
GRIP_CLEARANCE = 0.0   # metres left between gripper bottom and magazine top
GRIP_TIME = 1.0        # seconds to close / open the gripper
PAUSE_TIME = 0.5       # seconds to wait between steps
STOW_INSIDE = True     # lift the magazine up inside the OHT body for travel
STOW_MARGIN = 0.01     # metres the magazine bottom sits above the body bottom
CABLE_PATH = "/World/OHT_Hoist_Cables"
CABLE_WIDTH = 0.008    # metres
# Optional gripper fingers: (prim path, closing offset in metres in the
# finger's parent space). Leave empty if the gripper has no moving parts.
GRIPPER_FINGERS = [
    # ("/World/OHT2grip_Revised/Gripper/Finger_L", (0.0,  0.03, 0.0)),
    # ("/World/OHT2grip_Revised/Gripper/Finger_R", (0.0, -0.03, 0.0)),
]

# ------------------------------------------------------------
# Units and up axis
# ------------------------------------------------------------
MPU = UsdGeom.GetStageMetersPerUnit(stage) or 1.0
U = 1.0 / MPU
speed_u = SPEED * U
step_u = SAMPLE_STEP * U
snap_u = SNAP_TOL * U
junction_u = JUNCTION_RADIUS * U
half_span_u = 0.5 * HEADING_SPAN * U
height_u = HEIGHT_OFFSET * U
rail_offset_u = MAX_RAIL_OFFSET * U
hoist_speed_u = HOIST_SPEED * U
clearance_u = GRIP_CLEARANCE * U

Z_UP = UsdGeom.GetStageUpAxis(stage) == UsdGeom.Tokens.z
UP_VEC = np.array([0.0, 0.0, 1.0]) if Z_UP else np.array([0.0, 1.0, 0.0])
UP_GF = Gf.Vec3d(*UP_VEC)
UP_I = 2 if Z_UP else 1
H_IDX = [0, 1] if Z_UP else [0, 2]   # horizontal axes


def heading_deg(d):
    if Z_UP:
        return math.degrees(math.atan2(d[1], d[0]))
    return math.degrees(math.atan2(-d[2], d[0]))


def unit(v):
    n = np.linalg.norm(v)
    return v / n if n > 1e-12 else v


# ============================================================
# FIND OHT
# ============================================================
oht = stage.GetPrimAtPath(OHT_HINT)
if not oht.IsValid():
    candidates = [p for p in stage.Traverse() if "oht" in p.GetName().lower()
                  and not str(p.GetPath()).startswith(DEBUG_ROOT)]
    if not candidates:
        raise RuntimeError("No OHT found. Check the OHT model in the Stage panel.")
    oht = candidates[0]
print("OHT FOUND:", oht.GetPath())
for _path in HIDE_PRIMS:
    _p = stage.GetPrimAtPath(_path)
    if _p.IsValid() and _p != oht:
        UsdGeom.Imageable(_p).MakeInvisible()
        print("HIDDEN:", _path)
# remove a leftover "mount" op in case this prim was used as a hoist before
_xf = UsdGeom.Xformable(oht)
_ops = [op for op in _xf.GetOrderedXformOps() if op.GetOpName() != "xformOp:transform:mount"]
if len(_ops) != len(_xf.GetOrderedXformOps()):
    _xf.SetXformOpOrder(_ops)

# ============================================================
# CURVE SAMPLING
# ============================================================
def _count(ctrl):
    length = float(np.sum(np.linalg.norm(np.diff(ctrl, axis=0), axis=1)))
    return max(2, int(math.ceil(length / step_u)) + 1)


def _t(k):
    return np.linspace(0.0, 1.0, k)[:, None]


def _linear(q, k):
    return q[0] + (q[1] - q[0]) * _t(k)


def _bezier(q, k):
    t = _t(k)
    m = 1.0 - t
    return m**3 * q[0] + 3 * m**2 * t * q[1] + 3 * m * t**2 * q[2] + t**3 * q[3]


def _catmull(q, k):
    t = _t(k)
    return 0.5 * (2 * q[1] + (-q[0] + q[2]) * t
                  + (2 * q[0] - 5 * q[1] + 4 * q[2] - q[3]) * t**2
                  + (-q[0] + 3 * q[1] - 3 * q[2] + q[3]) * t**3)


def _bspline(q, k):
    t = _t(k)
    return ((1 - t)**3 * q[0]
            + (3 * t**3 - 6 * t**2 + 4) * q[1]
            + (-3 * t**3 + 3 * t**2 + 3 * t + 1) * q[2]
            + t**3 * q[3]) / 6.0


def _join(segs):
    if not segs:
        return None
    return np.vstack([segs[0]] + [s[1:] for s in segs[1:]])


def sample_curve(cp, ctype, basis, wrap):
    n = len(cp)
    if n < 2:
        return None
    if ctype == "linear" or n < 4:
        if wrap == "periodic":
            cp = np.vstack([cp, cp[:1]])
        return _join([_linear(cp[i:i + 2], _count(cp[i:i + 2]))
                      for i in range(len(cp) - 1)])
    if basis == "bezier":
        if wrap == "periodic":
            cp = np.vstack([cp, cp[:1]])
        return _join([_bezier(cp[i:i + 4], _count(cp[i:i + 4]))
                      for i in range(0, len(cp) - 3, 3)])
    fn = _catmull if basis == "catmullRom" else _bspline
    if wrap == "periodic":
        quads = [cp[[(i - 1) % n, i, (i + 1) % n, (i + 2) % n]] for i in range(n)]
    else:
        if wrap == "pinned":
            if basis == "catmullRom":
                cp = np.vstack([2 * cp[0] - cp[1], cp, 2 * cp[-1] - cp[-2]])
            else:
                cp = np.vstack([cp[:1], cp[:1], cp, cp[-1:], cp[-1:]])
        quads = [cp[i:i + 4] for i in range(len(cp) - 3)]
    return _join([fn(q, _count(q)) for q in quads])


def dedupe(pts):
    keep = [0]
    for i in range(1, len(pts)):
        if np.linalg.norm(pts[i] - pts[keep[-1]]) > 1e-6 * U:
            keep.append(i)
    return pts[keep]


def cumlen(pts):
    return np.concatenate([[0.0], np.cumsum(np.linalg.norm(np.diff(pts, axis=0), axis=1))])


# ============================================================
# COLLECT EVERY CURVE UNDER THE NETWORK ROOT
# ============================================================
root = stage.GetPrimAtPath(TRACK_ROOT)
if not root.IsValid():
    raise RuntimeError("Track root not found: " + TRACK_ROOT)

edges_raw = []
for prim in Usd.PrimRange(root):
    if not prim.IsA(UsdGeom.BasisCurves):
        continue
    bc = UsdGeom.BasisCurves(prim)
    ctype = str(bc.GetTypeAttr().Get() or "cubic")
    basis = str(bc.GetBasisAttr().Get() or "bezier")
    wrap = str(bc.GetWrapAttr().Get() or "nonperiodic")
    pts = bc.GetPointsAttr().Get()
    counts = bc.GetCurveVertexCountsAttr().Get()
    if not pts or not counts:
        continue
    raw = np.array(pts, dtype=float)
    M = np.array(UsdGeom.Xformable(prim).ComputeLocalToWorldTransform(TIME))
    raw_w = (np.c_[raw, np.ones(len(raw))] @ M)[:, :3]
    n_before = len(edges_raw)
    off = 0
    for c in counts:
        s = sample_curve(raw_w[off:off + c], ctype, basis, wrap)
        off += c
        if s is not None:
            s = dedupe(s)
            if len(s) >= 2:
                edges_raw.append(s)
    print(f"  {prim.GetPath()}: {len(counts)} curves, type={ctype}, "
          f"basis={basis}, wrap={wrap} -> {len(edges_raw) - n_before} edges")

if not edges_raw:
    raise RuntimeError("No BasisCurves found under " + TRACK_ROOT)

# ============================================================
# SPLIT EDGES AT T-JUNCTIONS
# ============================================================
all_pts = np.vstack(edges_raw)
owner = np.concatenate([np.full(len(e), i) for i, e in enumerate(edges_raw)])
local = np.concatenate([np.arange(len(e)) for e in edges_raw])
ends = np.array([e[0] for e in edges_raw] + [e[-1] for e in edges_raw])
cums = [cumlen(e) for e in edges_raw]

try:
    from scipy.spatial import cKDTree
    hits = cKDTree(all_pts).query_ball_point(ends, snap_u)
except ImportError:
    hits = [np.nonzero(np.linalg.norm(all_pts - p, axis=1) < snap_u)[0] for p in ends]

cuts = [set() for _ in edges_raw]
for k, h in enumerate(hits):
    best = {}
    for j in h:
        ei, li = int(owner[j]), int(local[j])
        d = np.linalg.norm(all_pts[j] - ends[k])
        if ei not in best or d < best[ei][1]:
            best[ei] = (li, d)
    for ei, (li, _) in best.items():
        if snap_u < cums[ei][li] < cums[ei][-1] - snap_u:
            cuts[ei].add(li)

pieces = []
for ei, e in enumerate(edges_raw):
    idx = [0] + sorted(cuts[ei]) + [len(e) - 1]
    for a, b in zip(idx[:-1], idx[1:]):
        if b > a:
            pieces.append(e[a:b + 1].copy())

# ============================================================
# BUILD GRAPH
# ============================================================
node_pos = []
grid = defaultdict(list)


def node_id(p):
    cell = tuple(np.floor(p / snap_u).astype(int))
    for dx in (-1, 0, 1):
        for dy in (-1, 0, 1):
            for dz in (-1, 0, 1):
                for nid in grid[(cell[0] + dx, cell[1] + dy, cell[2] + dz)]:
                    if np.linalg.norm(node_pos[nid] - p) < snap_u:
                        return nid
    node_pos.append(p.copy())
    grid[cell].append(len(node_pos) - 1)
    return len(node_pos) - 1


E = []
out_edges = defaultdict(list)


def add_edge(pts, twin=None):
    c = cumlen(pts)
    E.append({"pts": pts, "cum": c, "L": float(c[-1]),
              "n0": node_id(pts[0]), "n1": node_id(pts[-1]), "twin": twin})
    out_edges[E[-1]["n0"]].append(len(E) - 1)
    return len(E) - 1


for p in pieces:
    if cumlen(p)[-1] < 1e-6 * U:
        continue
    a = add_edge(p)
    if BIDIRECTIONAL:
        b = add_edge(p[::-1].copy(), twin=a)
        E[a]["twin"] = b


def point_on(e, s):
    cum = e["cum"]
    s = min(max(s, 0.0), e["L"])
    i = int(np.searchsorted(cum, s, side="right")) - 1
    i = min(max(i, 0), len(cum) - 2)
    seg = cum[i + 1] - cum[i]
    t = 0.0 if seg <= 0 else (s - cum[i]) / seg
    return e["pts"][i] + (e["pts"][i + 1] - e["pts"][i]) * t


def exit_dir(e):
    return unit(e["pts"][-1] - point_on(e, e["L"] - 2 * half_span_u))


def entry_dir(e):
    return unit(point_on(e, 2 * half_span_u) - e["pts"][0])


def successors(eid):
    """Edges the OHT can drive onto from the end of eid (no U-turns)."""
    e = E[eid]
    d = exit_dir(e)
    return [c for c in out_edges[e["n1"]]
            if c != e["twin"] and np.dot(d, entry_dir(E[c])) > 0.0]


# ------------------------------------------------------------
# BUILD THE MISSING JUNCTION PIECES
# The waypoint network only holds the straight rails; the curves and the
# short straights inside each junction block are missing. For every rail
# end that connects to nothing, connect it to every other loose rail end
# nearby that the OHT could physically drive into: straight on, or a
# smooth curve of up to MAX_TURN_DEG.
# ------------------------------------------------------------
def hermite(p0, d0, p1, d1, k):
    t = _t(k)
    L = np.linalg.norm(p1 - p0)
    h00 = 2 * t**3 - 3 * t**2 + 1
    h10 = t**3 - 2 * t**2 + t
    h01 = -2 * t**3 + 3 * t**2
    h11 = t**3 - t**2
    return h00 * p0 + h10 * L * d0 + h01 * p1 + h11 * L * d1


def connector(p0, d0, p1, d1):
    """Smooth path from p0 (heading d0) to p1 (arriving with heading d1)."""
    gap = p1 - p0
    k = max(6, int(math.ceil(np.linalg.norm(gap) * 1.6 / step_u)) + 1)
    # corner turn: quadratic Bezier through the point where both rails meet
    A = np.column_stack([d0, -d1])
    sol, *_ = np.linalg.lstsq(A, gap, rcond=None)
    a, b = sol
    if np.linalg.norm(np.cross(d0, d1)) > 0.3 and a > 0 and b > 0:
        c = p0 + a * d0
        t = _t(k)
        return (1 - t)**2 * p0 + 2 * (1 - t) * t * c + t**2 * p1
    return hermite(p0, d0, p1, d1, k)


# loose rail ends = nodes touched by exactly one rail
rails_at = defaultdict(set)
for i, e in enumerate(E):
    key = min(i, e["twin"]) if e["twin"] is not None else i
    rails_at[e["n0"]].add(key)
    rails_at[e["n1"]].add(key)
loose = {n for n, r in rails_at.items() if len(r) == 1}

cos_max_turn = math.cos(math.radians(MAX_TURN_DEG))
node_arr = np.array(node_pos)
bridge_ids = []
for eid in range(len(E)):
    e = E[eid]
    if successors(eid):
        continue
    p, d = e["pts"][-1], exit_dir(e)
    dist = np.linalg.norm(node_arr - p, axis=1)
    for nid in np.nonzero(dist < junction_u)[0]:
        nid = int(nid)
        if nid == e["n1"] or nid == e["n0"] or nid not in loose:
            continue
        g = unit(node_arr[nid] - p)
        for c in out_edges[nid]:
            d1 = entry_dir(E[c])
            if np.dot(g, d) < 0.3 or np.dot(g, d1) < 0.3:      # must lie ahead
                continue
            if np.dot(d, d1) < cos_max_turn:                    # no U-turns
                continue
            bridge_ids.append(add_edge(connector(p, d, node_arr[nid], d1)))

bridges = len(bridge_ids)

dead = [eid for eid in range(len(E)) if not successors(eid)]
print(f"TRACK GRAPH: {len(E)} edges, {len(node_pos)} nodes, "
      f"{bridges} junction connections built, {len(dead)} dead ends left")

# ============================================================
# START: nearest rail to the OHT, in the direction that goes furthest
# ============================================================
m = UsdGeom.Xformable(oht).ComputeLocalToWorldTransform(TIME)
oht_pos = np.array([m[3][0], m[3][1], m[3][2]], dtype=float)

ranked = []
for i, e in enumerate(E):
    d = np.linalg.norm(e["pts"] - oht_pos, axis=1)
    j = int(np.argmin(d))
    ranked.append((float(d[j]), i, float(e["cum"][j])))
ranked.sort()


def reachable(start):
    seen, stack = {start}, [start]
    while stack:
        for n in successors(stack.pop()):
            if n not in seen:
                seen.add(n)
                stack.append(n)
    return len(seen)


_, start_edge, start_s = ranked[0]
twin = E[start_edge]["twin"]
if twin is not None and reachable(twin) > reachable(start_edge):
    start_s = E[start_edge]["L"] - start_s
    start_edge = twin
print(f"START: {ranked[0][0] * MPU:.3f} m from rail, "
      f"{reachable(start_edge)} edges reachable ahead")

# ============================================================
# DEBUG DRAWING (yellow = rail ends that connect to nothing)
# ============================================================
stage.RemovePrim(DEBUG_ROOT)
UsdGeom.Xform.Define(stage, DEBUG_ROOT)
if dead and SHOW_DEAD_END_MARKERS:
    dp = UsdGeom.Points.Define(stage, DEBUG_ROOT + "/Dead_Ends")
    dp.CreatePointsAttr(Vt.Vec3fArray(
        [Gf.Vec3f(*map(float, E[i]["pts"][-1] + UP_VEC * 0.05 * U)) for i in dead]))
    dp.CreateWidthsAttr(Vt.FloatArray([0.25 * U] * len(dead)))
    dp.CreateDisplayColorAttr(Vt.Vec3fArray([Gf.Vec3f(1, 1, 0)]))

if bridge_ids:
    jc = UsdGeom.BasisCurves.Define(stage, DEBUG_ROOT + "/Junction_Connections")
    jc.CreateTypeAttr(UsdGeom.Tokens.linear)
    pts_all, cnts = [], []
    for i in bridge_ids:
        pts_all += [Gf.Vec3f(*map(float, q + UP_VEC * 0.05 * U)) for q in E[i]["pts"]]
        cnts.append(len(E[i]["pts"]))
    jc.CreatePointsAttr(Vt.Vec3fArray(pts_all))
    jc.CreateCurveVertexCountsAttr(Vt.IntArray(cnts))
    jc.CreateWidthsAttr(Vt.FloatArray([0.04 * U]))
    jc.SetWidthsInterpolation(UsdGeom.Tokens.constant)
    jc.CreateDisplayColorAttr(Vt.Vec3fArray([Gf.Vec3f(0, 1, 1)]))
    UsdGeom.Imageable(jc.GetPrim()).MakeInvisible()

# Hide the complete generated debug group, including any endpoint markers.
UsdGeom.Imageable(stage.GetPrimAtPath(DEBUG_ROOT)).MakeInvisible()

# ============================================================
# ROUTE CHOICE
# ============================================================
def choose_next(eid):
    cands = successors(eid)
    if not cands:
        return None
    if len(cands) == 1:
        return cands[0]
    d = exit_dir(E[eid])
    turn = lambda c: np.dot(d, entry_dir(E[c]))   # 1 = straight, lower = turning
    if AT_JUNCTION == "turn":
        return min(cands, key=turn)
    return max(cands, key=turn)


def route_point(prev, cur, nxt, s):
    L = E[cur]["L"]
    if s > L and nxt is not None:
        return point_on(E[nxt], s - L)
    if s < 0 and prev is not None:
        return point_on(E[prev], E[prev]["L"] + s)
    return point_on(E[cur], s)

# ============================================================
# OHT TRANSFORM SETUP
# ============================================================
xform = UsdGeom.Xformable(oht)
OP_NAMES = ["xformOp:translate:oht", "xformOp:orient:oht", "xformOp:scale:oht"]
BASE_KEY = "ohtFollowerBaseOrient"

stored = oht.GetCustomDataByKey(BASE_KEY)
gt = Gf.Transform(xform.GetLocalTransformation(TIME))
if stored is None:
    q = gt.GetRotation().GetQuat()
    im = q.GetImaginary()
    stored = Gf.Vec4d(q.GetReal(), im[0], im[1], im[2])
    oht.SetCustomDataByKey(BASE_KEY, stored)
base_rot = Gf.Rotation(Gf.Quatd(stored[0], Gf.Vec3d(stored[1], stored[2], stored[3])))

if [op.GetOpName() for op in xform.GetOrderedXformOps()] != OP_NAMES:
    base_scale = Gf.Vec3d(gt.GetScale())
    xform.ClearXformOpOrder()
    t_op = xform.AddTranslateOp(UsdGeom.XformOp.PrecisionDouble, "oht")
    o_op = xform.AddOrientOp(UsdGeom.XformOp.PrecisionDouble, "oht")
    s_op = xform.AddScaleOp(UsdGeom.XformOp.PrecisionDouble, "oht")
    s_op.Set(base_scale)
else:
    t_op, o_op, s_op = xform.GetOrderedXformOps()

parent = oht.GetParent()
if parent.IsValid() and parent.GetPath() != stage.GetPseudoRoot().GetPath():
    parent_inv = UsdGeom.Xformable(parent).ComputeLocalToWorldTransform(TIME).GetInverse()
else:
    parent_inv = Gf.Matrix4d(1.0)


# filled in below once the OHT's own size is measured
oht_frame = {"anchor": Gf.Vec3d(0, 0, 0), "yaw": 0.0}


def apply_pose(world_pos, world_dir):
    """Put the OHT's rail anchor (top centre of the body) on the rail point,
    turned to the rail direction."""
    ld = parent_inv.TransformDir(Gf.Vec3d(*map(float, world_dir)))
    yaw = heading_deg(ld) + YAW_OFFSET_DEG + oht_frame["yaw"]
    rot = base_rot * Gf.Rotation(UP_GF, yaw)
    wp = world_pos + UP_VEC * height_u
    lp = parent_inv.Transform(Gf.Vec3d(*map(float, wp)))
    t_op.Set(lp - rot.TransformDir(oht_frame["anchor"]))
    o_op.Set(rot.GetQuat())


# ============================================================
